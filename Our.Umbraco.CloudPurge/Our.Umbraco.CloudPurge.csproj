<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>CloudPurge</PackageId>
    <Version>1.0.0-preview2</Version>
    <Title>CloudPurge for Umbraco</Title>
    <Authors>Anthony Halliday</Authors>
    <Description>Purges Cloudflare cache when Umbraco content changes, with an editor action for manual purging.</Description>
    <PackageTags>Umbraco;Cloudflare;Cache</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/anth12/CloudPurge</RepositoryUrl>
    <UmbracoVersion Condition="'$(UmbracoVersion)' == ''">17.0.2</UmbracoVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="$(UmbracoVersion)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\logo.png" Pack="true" PackagePath="" />
    <None Include="..\readme.md" Pack="true" PackagePath="README.md" />
    <None Include="App_Plugins\CloudPurge\**\*" Pack="true" PackagePath="contentFiles\any\any\App_Plugins\CloudPurge\" />
    <None Include="buildTransitive\CloudPurge.targets" Pack="true" PackagePath="buildTransitive\CloudPurge.targets" />
  </ItemGroup>
</Project>
